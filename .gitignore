# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# fontes de vídeo (originais pesados — só os derivados comprimidos vão pro repo)
public/*.MOV
public/*.mov

# oficinas de imagem: fotos originais, recortes e mosaicos de trabalho. São
# ~150MB que não têm por que viver no repo do site — só o derivado final vai
# pro `public/`. O contexto para tocar isso fora daqui está em
# `docs/colagem-radicais.md`.
/fotos-radicais-livres/
/colagem-fotos/

# material cru: originais pesados que você joga pra eu converter e levar
# pro `public/`. O contrato está em `material/LEIA-ME.md`.
/material/

# catálogo gerado: 3,5MB de miniaturas embutidas, regerável com
# `node scripts/gerar-acervo.js`. O script vai pro git, o produto dele não.
/docs/acervo.html
